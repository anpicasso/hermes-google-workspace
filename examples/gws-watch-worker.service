[Unit]
Description=Hermes GWS targeted-watch worker (one profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set the exact profile home; never rely on the login shell's default profile.
Environment=HERMES_HOME=/home/example/.hermes
# Replace with the immutable checkout/runtime path.
WorkingDirectory=/opt/hermes-google-workspace
ExecStart=/home/example/.hermes/hermes-agent/venv/bin/python /opt/hermes-google-workspace/watch_worker.py run \
  --home /home/example/.hermes \
  --profile default \
  --gws-bin /usr/local/bin/gws \
  --callback-host 127.0.0.1 \
  --callback-port 8765 \
  --gmail-topic projects/example-project/topics/gmail-watch \
  --gmail-subscription projects/example-project/subscriptions/gmail-watch \
  --callback-url https://watch.example.com
Restart=on-failure
RestartSec=10
# Use a dependency-complete Python (aiohttp, PyYAML, google-auth and requests).
# The worker writes watch state; native gws writes its own credential/cache files.
# Delivery routes are provisioned by the operator, not modified by this worker.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/example/.hermes
UMask=0077

[Install]
WantedBy=default.target
