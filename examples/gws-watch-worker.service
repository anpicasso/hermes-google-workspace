[Unit]
Description=Hermes GWS targeted-watch worker (one profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set the exact profile home; never rely on the login shell's default profile.
Environment=HERMES_HOME=/home/example/.hermes
# Replace with the immutable checkout/runtime path.
WorkingDirectory=/opt/hermes-gws-oauth
ExecStart=/home/example/.hermes/hermes-agent/venv/bin/python /opt/hermes-gws-oauth/watch_worker.py run \
  --home /home/example/.hermes \
  --gws-bin /usr/local/bin/gws \
  --callback-host 127.0.0.1 \
  --callback-port 8765 \
  --gmail-topic projects/example-project/topics/gmail-watch \
  --gmail-subscription projects/example-project/subscriptions/gmail-watch \
  --callback-url https://watch.example.com
Restart=on-failure
RestartSec=10
# Use the dependency-complete Hermes Python above (aiohttp + PyYAML).
# Native route CAS uses atomic rename in the profile root; token refresh also writes.
# This grants the selected profile write access, not just the SQLite directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/example/.hermes
UMask=0077

[Install]
WantedBy=default.target
